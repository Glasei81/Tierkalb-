# === HerdenPilot — Einstellungen ===
# Kopiere diese Datei zu ".env" und trage deine Werte ein:
#     cp .env.example .env
# Die .env-Datei bleibt lokal und landet NICHT auf GitHub (.gitignore).

# Passwort fuer den Zugriff ueber den Browser.
# Leer lassen = kein Login (nur fuer lokal/Tailscale-privat).
# UNBEDINGT setzen, sobald HerdenPilot ueber Tailscale Funnel
# oeffentlich im Internet erreichbar ist.
LOGIN_PASSWORD=

# Optionaler fester Schluessel fuer die Login-Sitzungen.
# Leer lassen = HerdenPilot erzeugt automatisch einen dauerhaften Schluessel.
SECRET_KEY=
